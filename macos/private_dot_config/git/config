#
# .gitconfig
#
[core]
    excludesfile = ~/.gitignore
#    attributesfile = ~/.gitattributes
    editor = emacs #nano
#    pager = more -d #more -eR #lv -c #less #
    # Unicode
    precomposeunicode = true
    quotepath = false 
[user]
    name = ryosuke
    email = yamryo0202@gmail.com
[push]
    # simple,matching,upstream,current
    default = simple
    autoSetupRemote = true
[color]
    ui = auto
[diff]
    patience = true
[help]
    autocorrect = 0
[alias]
#    co = checkout
    cmt = commit -v
    ce = commit -v --amend
    st = status --branch
    sts = status --branch --short
    sti = status --ignored --short
    br = branch
    brs = branch -a
    remotes = remote -v
    tags = tag -l
    lg = log --graph --all --decorate --abbrev-commit --branches --date=short --pretty=format:\"%C(red)%h%C(reset) %C(green)[%ad]%C(reset) %s %C(cyan)@%an%C(reset) %C(yellow)%d%C(reset)\"
    fp = fetch --prune
    dh = diff --histogram
    dw = diff --word-diff
    dc = diff --cached
    ls = !git ls-files -t|perl -pe 's/\\/.*/\\//'|uniq -c
    ll = !git ls-files -cdmokt|perl -pe 's/\\/.*/\\//'|grep -v '/'
    cof = !git branch --format='%(refname:short)' | fzf | xargs git switch
[merge]
    tool = meld
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
